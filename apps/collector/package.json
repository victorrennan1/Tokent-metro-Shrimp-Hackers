{
  "name": "tokentometro",
  "version": "0.1.0-beta.1",
  "description": "Coletor local, privado e somente leitura do Tokentômetro",
  "author": "Victor Rennan",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorrennan1/Tokent-metro-Shrimp-Hackers.git",
    "directory": "apps/collector"
  },
  "homepage": "https://github.com/victorrennan1/Tokent-metro-Shrimp-Hackers/tree/main/apps/collector#readme",
  "bugs": {
    "url": "https://github.com/victorrennan1/Tokent-metro-Shrimp-Hackers/issues"
  },
  "keywords": ["tokens", "telemetry", "claude-code", "codex", "privacy", "cli"],
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "tokentometro": "./dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "prepack": "corepack pnpm build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@inquirer/prompts": "7.4.1",
    "ccusage": "20.0.36",
    "chalk": "5.4.1",
    "commander": "13.1.0",
    "conf": "13.1.0",
    "execa": "9.5.2",
    "ora": "8.2.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@tokentometro/contracts": "workspace:*",
    "tsup": "8.4.0",
    "tsx": "4.19.3",
    "vitest": "3.0.8"
  }
}

