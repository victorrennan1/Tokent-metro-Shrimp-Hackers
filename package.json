{
  "name": "tokentometro",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "corepack pnpm --filter @tokentometro/web dev",
    "build": "corepack pnpm -r build",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test",
    "audit:persistent": "node scripts/audit-persistent-flow.mjs",
    "audit:idempotency": "node scripts/audit-idempotent-ingest.mjs",
    "audit:revocation": "node scripts/audit-revocation.mjs",
    "format": "prettier --write .",
    "check": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "prettier": "3.5.3",
    "typescript": "5.8.2"
  }
}

